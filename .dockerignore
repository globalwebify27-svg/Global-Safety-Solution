# Ignore local dependency folders (Docker will install its own inside the container)
**/node_modules
**/dist
**/.next
**/.turbo

# Ignore temporary/log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Ignore system files
.git
.gitignore
.vscode
.env
.env.local

# Ignore large media/archives
*.zip
*.tar.gz
*.png
*.jpg
*.jpeg
